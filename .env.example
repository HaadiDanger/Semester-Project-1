# Browser-safe configuration only. Get these from your intended Supabase project.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_APP_URL=http://localhost:5173

# Never put a service-role/secret key in a VITE_ variable.
# Local fixture credentials are read separately by scripts/seed-dev.mjs.
# Set up server-side Gmail with npm run email:setup; see docs/email.md.
